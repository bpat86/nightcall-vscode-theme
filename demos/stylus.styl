$accent = #ff7ec7
$spacing = .25rem

surface($background = #171821)
  color #f7f7fb
  background-color $background

.project-grid
  display grid
  gap $spacing * 4

  &__card
    surface()
    padding $spacing * 6
    border 1px solid alpha($accent, .4)

    &:hover
      transform translateY(-$spacing)

@media (min-width: 64rem)
  .project-grid
    grid-template-columns repeat(3, minmax(0, 1fr))
