doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= pageTitle

  body
    header
      nav(aria-label="Primary navigation")
        a(href="/") Nightcall
    main
      h1= heading
      if projects.length
        ul.project-list
          each project in projects
            li(data-id=project.id)
              a(href=`/projects/${project.slug}`)= project.name
      else
        p No projects yet.
